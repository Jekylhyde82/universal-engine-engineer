{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/performance-lab/run-record.schema.json",
  "title": "Performance Lab run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "test_id",
    "case_id",
    "condition",
    "status",
    "timestamp_utc",
    "operator",
    "repetition",
    "input_sha256",
    "configuration",
    "raw_output",
    "raw_output_sha256",
    "scores",
    "hard_gates",
    "limitations",
    "confounders",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "test_id": {
      "enum": [
        "PL-001",
        "PL-002",
        "PL-003",
        "PL-004",
        "PL-005"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "enum": [
        "baseline",
        "experimental"
      ]
    },
    "status": {
      "enum": [
        "captured",
        "not_assessed"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration": {
      "type": "object"
    },
    "raw_output": {
      "type": "string"
    },
    "raw_output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          {
            "const": "NOT_ASSESSED"
          }
        ]
      }
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confounders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "not_scored",
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "reviewer": {
      "type": "string"
    },
    "independent_review_reference": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
