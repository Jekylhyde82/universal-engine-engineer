{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/performance-lab/run-record.schema.json",
  "title": "Performance Lab run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "test_id",
    "case_id",
    "condition",
    "status",
    "timestamp_utc",
    "operator",
    "repetition",
    "input_sha256",
    "configuration",
    "configuration_sha256",
    "raw_output",
    "raw_output_sha256",
    "scores",
    "hard_gates",
    "limitations",
    "confounders",
    "decision",
    "reviewer",
    "independent_review_reference",
    "trial_execution",
    "assessor",
    "adversarial_review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "test_id": {
      "enum": [
        "PL-001",
        "PL-002",
        "PL-003",
        "PL-004",
        "PL-005"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "enum": [
        "baseline",
        "experimental",
        "specialist_1",
        "specialist_2",
        "specialist_3",
        "specialist_4",
        "specialist_5",
        "specialist_6",
        "specialist_7",
        "specialist_8",
        "specialist_9",
        "fused"
      ]
    },
    "status": {
      "enum": [
        "captured",
        "not_assessed"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration": {
      "type": "object"
    },
    "raw_output": {
      "type": "string"
    },
    "raw_output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          {
            "const": "NOT_ASSESSED"
          }
        ]
      }
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safety",
        "no_fabricated_evidence",
        "no_unauthorized_side_effect",
        "no_critical_unreported_failure"
      ],
      "properties": {
        "safety": {
          "enum": [
            "pass",
            "fail",
            "not_assessed"
          ]
        },
        "no_fabricated_evidence": {
          "enum": [
            "pass",
            "fail",
            "not_assessed"
          ]
        },
        "no_unauthorized_side_effect": {
          "enum": [
            "pass",
            "fail",
            "not_assessed"
          ]
        },
        "no_critical_unreported_failure": {
          "enum": [
            "pass",
            "fail",
            "not_assessed"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confounders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "not_scored",
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "reviewer": {
      "type": "string"
    },
    "independent_review_reference": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trial_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "blind_label",
        "unpersonalized_confirmed",
        "context_type",
        "context_reference",
        "captured_at",
        "model_label",
        "settings",
        "tools_used",
        "capture_reference",
        "canonical_prompt_sha256",
        "raw_response_sha256"
      ],
      "properties": {
        "trial_id": {
          "type": "string",
          "pattern": "^TRIAL-[0-9]{3,}$"
        },
        "blind_label": {
          "type": "string",
          "pattern": "^BLIND-[0-9]{3,}$"
        },
        "unpersonalized_confirmed": {
          "const": true
        },
        "context_type": {
          "const": "Unpersonalized Temporary Chat"
        },
        "context_reference": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "model_label": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "string",
          "minLength": 1
        },
        "tools_used": {
          "type": "string",
          "minLength": 1
        },
        "capture_reference": {
          "type": "string",
          "minLength": 1
        },
        "canonical_prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_response_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "architecture_instruction_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessor_id",
        "blinded_condition",
        "independent"
      ],
      "properties": {
        "assessor_id": {
          "type": "string",
          "minLength": 1
        },
        "blinded_condition": {
          "const": true
        },
        "independent": {
          "const": true
        }
      }
    },
    "adversarial_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "blinded_condition",
        "independent",
        "checks"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "blinded_condition": {
          "const": true
        },
        "independent": {
          "const": true
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "outcome",
              "finding"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail",
                  "not_assessed"
                ]
              },
              "finding": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
