{
  "catalog_id": "UNIVERSAL-ENGINEER-PERFORMANCE-LAB",
  "version": "1.0.0",
  "status": "specified_not_executed",
  "tests": [
    {
      "id": "PL-001",
      "name": "Grounded reasoning and uncertainty",
      "layer": [
        "individual",
        "system"
      ],
      "measures": [
        "correctness",
        "evidence_quality",
        "calibration",
        "uncertainty_disclosure"
      ],
      "critical_failures": [
        "fabricated_source",
        "unsupported_high_confidence_claim",
        "material_factual_error"
      ]
    },
    {
      "id": "PL-002",
      "name": "Research and capability acquisition",
      "layer": [
        "individual",
        "fusion"
      ],
      "measures": [
        "search_coverage",
        "source_quality",
        "provenance",
        "synthesis",
        "license_awareness",
        "security_awareness"
      ],
      "critical_failures": [
        "untraceable_source",
        "license_misrepresentation",
        "unsafe_candidate_recommendation_without_disclosure"
      ]
    },
    {
      "id": "PL-003",
      "name": "Engineering execution",
      "layer": [
        "system"
      ],
      "measures": [
        "requirements_traceability",
        "implementation_correctness",
        "build_reproducibility",
        "test_coverage",
        "maintainability"
      ],
      "critical_failures": [
        "unreviewed_production_change",
        "secret_exposure",
        "false_completion_claim"
      ]
    },
    {
      "id": "PL-004",
      "name": "Independent critic and adversarial verification",
      "layer": [
        "individual",
        "system"
      ],
      "measures": [
        "defect_detection",
        "severity_accuracy",
        "reproduction_quality",
        "false_positive_control",
        "risk_coverage"
      ],
      "critical_failures": [
        "missed_known_critical_defect",
        "unreproducible_finding_presented_as_confirmed"
      ]
    },
    {
      "id": "PL-005",
      "name": "Fusion synergy and evolution",
      "layer": [
        "fusion",
        "evolution"
      ],
      "measures": [
        "incremental_task_success",
        "synergy",
        "ablation_delta",
        "regression_rate",
        "repeatability",
        "resource_cost"
      ],
      "critical_failures": [
        "claimed_synergy_without_isolated_comparator",
        "regression_hidden_by_aggregate_score"
      ]
    }
  ],
  "protocol": {
    "minimum_repetitions": 3,
    "comparison": "same task and rubric; PL-001 through PL-004 compare baseline vs experimental; PL-005 compares baseline, nine isolated specialist arms and fused",
    "report": [
      "all_raw_runs",
      "median",
      "range",
      "per_dimension_scores",
      "worst_dimension",
      "confounders"
    ],
    "scoring_scale": "1_to_5_then_normalized_to_0_to_100; use NOT_ASSESSED when evidence is insufficient",
    "aggregate_score_is_not_an_acceptance_gate": true
  },
  "evidence_requirements": [
    "run_id",
    "test_id",
    "catalog_version",
    "objective_and_hypothesis",
    "input_reference_or_hash",
    "baseline_configuration",
    "experimental_configuration",
    "timestamp_utc",
    "model_and_tool_versions",
    "procedure_and_repetition",
    "raw_output_reference",
    "rubric_version",
    "dimension_scores",
    "defects_and_limitations",
    "confounders_and_deviations",
    "pass_fail_and_reviewer",
    "commit_or_deployment_identity_when_applicable"
  ]
}
