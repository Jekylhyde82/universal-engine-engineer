{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/performance-lab/test-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_id",
    "version",
    "status",
    "tests",
    "protocol",
    "evidence_requirements"
  ],
  "properties": {
    "catalog_id": {
      "const": "UNIVERSAL-ENGINEER-PERFORMANCE-LAB"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "layer",
          "measures",
          "critical_failures"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PL-00[1-5]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "measures": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "critical_failures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "minimum_repetitions",
        "comparison",
        "report",
        "scoring_scale",
        "aggregate_score_is_not_an_acceptance_gate"
      ],
      "properties": {
        "minimum_repetitions": {
          "type": "integer",
          "minimum": 3
        },
        "comparison": {
          "type": "string"
        },
        "report": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scoring_scale": {
          "type": "string"
        },
        "aggregate_score_is_not_an_acceptance_gate": {
          "const": true
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
