{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Capability Candidate",
  "type": "object",
  "required": [
    "id",
    "name",
    "url",
    "category",
    "disposition",
    "retrieved_at",
    "gates"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string"
    },
    "stars": {
      "type": "integer",
      "minimum": 0
    },
    "forks": {
      "type": "integer",
      "minimum": 0
    },
    "license": {
      "type": "string"
    },
    "archived": {
      "type": "boolean"
    },
    "default_branch": {
      "type": "string"
    },
    "pushed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "disposition": {
      "enum": [
        "DISCOVERED",
        "TRIAGE_REQUIRED",
        "EVALUATION_IN_PROGRESS",
        "PROOF_OF_CAPABILITY_REQUIRED",
        "APPROVED_FOR_ADAPTER_DESIGN",
        "DEFERRED",
        "BLOCKED",
        "REJECTED"
      ]
    },
    "intended_capability": {
      "type": "string"
    },
    "evidence_notes": {
      "type": "string"
    },
    "risks": {
      "type": "string"
    },
    "gates": {
      "type": "object",
      "required": [
        "G0_SOURCE_IDENTITY",
        "G1_LICENCE_AND_PROVENANCE",
        "G2_MAINTENANCE_AND_COMPATIBILITY",
        "G3_SECURITY_AND_GOVERNANCE",
        "G4_RESOURCE_AND_DEPLOYMENT",
        "G5_PROOF_OF_CAPABILITY",
        "G6_INTEGRATION_APPROVAL",
        "G7_OPERATIONAL_VERIFICATION"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}