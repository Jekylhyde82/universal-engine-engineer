{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-engine-engineer.invalid/schemas/omnisight/capability-manifest.schema.json",
  "title": "OMNISIGHT PRIME Specialist Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "semantic_version",
    "domain",
    "operations",
    "input_schema",
    "output_schema",
    "runtime_requirements",
    "permission_scopes",
    "lifecycle_state"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "domain": {
      "enum": [
        "acquisition",
        "processing",
        "recognition",
        "spatial",
        "reasoning",
        "temporal",
        "context-memory",
        "interaction-autonomy",
        "assurance-evolution"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "input_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "output_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "supported_modalities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "screen",
          "image",
          "video",
          "camera",
          "document",
          "diagram",
          "text",
          "other"
        ]
      }
    },
    "runtime_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "minimum_ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "network_required": {
          "type": "boolean"
        },
        "accelerators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "permission_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lifecycle_state": {
      "enum": [
        "discovered",
        "proposed",
        "under_evaluation",
        "approved",
        "integrated",
        "rejected",
        "retired"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "source_revision": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        },
        "review_record": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "enum": [
              "approved",
              "integrated"
            ]
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "required": [
          "artifact_digest",
          "provenance"
        ],
        "properties": {
          "provenance": {
            "required": [
              "source_uri",
              "source_revision",
              "licence",
              "review_record"
            ]
          }
        }
      }
    }
  ]
}
